# iSai Bot Environment Variables
# ================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to source control.

# Multi-Instance Discord Bot Configuration
# Configure one or more bots below. The manager will launch an instance for each token found.

# Bot 1
BOT_TOKEN_1=your_first_discord_bot_token_here
# Optional: restrict this bot to a specific voice channel
# ASSIGNED_VC_1=123456789012345678

# Bot 2
# BOT_TOKEN_2=your_second_discord_bot_token_here
# ASSIGNED_VC_2=876543210987654321

# Optional: Absolute path to your music folder.
# Defaults to the "music/" directory at the project root.
# MUSIC_FOLDER=C:\Users\YourName\Music

# Optional: Path to the ffmpeg executable.
# If ffmpeg is on your system PATH, leave this as "ffmpeg".
# FFMPEG_PATH=ffmpeg
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe

# Optional: Default playback volume (0.0 to 1.0)
# DEFAULT_VOLUME=0.5

# Optional: Minimum fuzzy search score (0-100). Lower = more lenient matches.
# FUZZY_SCORE_THRESHOLD=55
